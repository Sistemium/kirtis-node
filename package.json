{
  "name": "kirtis-node",
  "version": "1.0.0",
  "description": "API of kirtis.info",
  "main": "dist/api",
  "scripts": {
    "serve": "tsc-watch --onSuccess \"node -r dotenv-flow/config dist/api.js\"",
    "build": "rm -rf dist && tsc && cp package.json dist",
    "test": "mocha -r ts-node/register/transpile-only -r dotenv-flow/config test/testVdu.js test/testLiepa.js test/testSuggestions.js",
    "phonology:build": "bash phonology/build.sh",
    "phonology:demo": "ts-node -P phonology/tsconfig.json phonology/demo.ts",
    "phonology:compare": "ts-node -P phonology/tsconfig.json phonology/compare.ts"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "Sistemium UAB",
  "license": "ISC",
  "dependencies": {
    "@koa/router": "^15.7.0",
    "async": "^3.2.6",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-logger": "^4.0.0",
    "lodash": "^4.18.1",
    "sistemium-data": "^1.11.15",
    "sistemium-data-mongo": "^1.7.7",
    "sistemium-debug": "^1.1.3",
    "sistemium-mongo": "^1.20.0",
    "sistemium-redis": "^1.1.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.26",
    "@types/chai": "^5.2.3",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-logger": "^3.1.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "chai": "^6.3.0",
    "dotenv-flow": "^4.1.0",
    "mocha": "^12.0.3",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "6.0.3"
  }
}
